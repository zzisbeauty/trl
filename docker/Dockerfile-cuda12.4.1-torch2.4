# 使用您本地的 torch 2.4 镜像  
FROM stdcuda:12.4.1  
  
# 设置工作目录  
WORKDIR /workspace  
  
# 安装系统依赖  
#RUN apt-get update && apt-get install -y \  
#    make \  
#    git \  
#    curl \  
#    vim \  
#    && rm -rf /var/lib/apt/lists/*  
  
# 安装 uv 包管理器  
RUN curl -LsSf https://astral.sh/uv/install.sh | sh  
ENV PATH="/root/.local/bin:${PATH}"  
  
# 创建必要的目录结构  
RUN mkdir -p /workspace/trl \  
    /workspace/models \  
    /workspace/data \  
    /workspace/output  
  
# 设置 Python 环境变量  
ENV PYTHONUNBUFFERED=1  
ENV CUDA_VISIBLE_DEVICES=0  
  
# 默认命令:启动 bash  
CMD ["/bin/bash"]